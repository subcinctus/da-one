{
  "name": "answer-desk",
  "private": true,
  "type": "module",
  "description": "Answer Rewrite Desk: check an answer with open-source AI-text detectors in the browser and rewrite the flagged sentences safely.",
  "scripts": {
    "build": "python3 tools/build_artifact.py site --site",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "e2e": "node tests/e2e/run-all.mjs site"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.1.3",
    "@mlc-ai/web-llm": "0.2.86",
    "harper.js": "2.13.0",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
